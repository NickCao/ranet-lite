#!/bin/sh
set -eu

/usr/lib/ipsec/charon --debug-ike 2 --debug-cfg 1 &
charon_pid=$!
trap 'kill "$charon_pid" 2>/dev/null || true; wait "$charon_pid" 2>/dev/null || true' EXIT INT TERM

attempt=0
until [ -S /var/run/charon.vici ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        exit 1
    fi
    sleep 0.1
done

swanctl --load-all

echo "strongSwan ready"
wait "$charon_pid"
